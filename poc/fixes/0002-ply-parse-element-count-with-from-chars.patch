Fix PLY importer terminating on an invalid element count.

std::stoi() throws on non-numeric or out-of-range counts, and nothing on the
call chain handles the exception. Parse with std::from_chars() and return a
proper error instead.

--- a/source/blender/io/ply/importer/ply_import.cc
+++ b/source/blender/io/ply/importer/ply_import.cc
@@ -7,6 +7,7 @@
  */
 
 #include <array>
+#include <charconv>
 #include <string>
 
 #include "BKE_context.hh"
@@ -139,7 +140,13 @@
       element.name = std::string(word.data(), word.size());
       skip_space(line);
       word = parse_word(line);
-      element.count = std::stoi(std::string(word.data(), word.size()));
+      if (word.is_empty() ||
+          std::from_chars(word.data(), word.data() + word.size(), element.count).ec !=
+              std::errc() ||
+          element.count < 0)
+      {
+        return "Invalid element count.";
+      }
       r_header.elements.append(element);
     }
     else if (parse_keyword(line, "property")) {
